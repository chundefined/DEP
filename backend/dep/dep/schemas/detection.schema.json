{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/dep/schemas/detection.schema.json",
  "title": "DEP Detection Definition",
  "description": "Canonical schema for detection.yml - Detection Engineering Platform",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "status", "description", "severity", "detection_type", "intent", "governance", "documentation"],
  "additionalProperties": false,

  "properties": {
    "schema_version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^DET-\\d{4,}$" },
    "uuid": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 3, "maxLength": 160 },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "$ref": "#/$defs/lifecycleStatus" },
    "description": { "type": "string", "minLength": 20 },
    "severity": { "type": "string" },
    "confidence": { "enum": ["low", "medium", "high"] },
    "risk_score": { "type": "integer", "minimum": 0, "maximum": 100 },
    "detection_type": {
      "enum": ["signature", "threshold", "anomaly", "correlation", "behavioral", "ml", "threat_intel", "hunting"]
    },
    "alert_disposition": { "enum": ["alert", "incident", "hunt_only", "enrichment_only"] },
    "false_positive_rate_expected": { "enum": ["low", "medium", "high"] },
    "tlp": { "enum": ["clear", "green", "amber", "red"] },
    "visibility": { "enum": ["internal", "shareable", "restricted"] },
    "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": { "enum": ["custom", "content_hub", "sigma_community", "vendor", "migrated_qradar", "other"] },
        "reference": { "type": ["string", "null"] },
        "original_author": { "type": ["string", "null"] },
        "template_version": { "type": ["string", "null"] }
      }
    },

    "intent": {
      "type": "object",
      "required": ["summary", "adversary_behavior"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 10 },
        "hypothesis": { "type": "string" },
        "adversary_behavior": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "preconditions": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "included": { "type": "array", "items": { "type": "string" } },
            "excluded": { "type": "array", "items": { "type": "string" } }
          }
        },
        "evasion_notes": { "type": "string" },
        "kill_chain_phase": { "type": "array", "items": { "type": "string" } },
        "attack_surface": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "mitre": {
      "type": "object",
      "required": ["attack_version", "mappings"],
      "additionalProperties": false,
      "properties": {
        "attack_version": { "type": "string" },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tactic", "technique", "coverage_level", "primary"],
            "additionalProperties": false,
            "properties": {
              "tactic": { "type": "string", "pattern": "^TA\\d{4}$" },
              "technique": { "type": "string", "pattern": "^T\\d{4}$" },
              "subtechnique": { "type": ["string", "null"], "pattern": "^T\\d{4}\\.\\d{3}$" },
              "coverage_level": { "enum": ["none", "minimal", "partial", "significant", "complete"] },
              "detection_confidence": { "enum": ["low", "medium", "high"] },
              "primary": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },

    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "strength"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "strength": { "enum": ["primary", "supporting", "partial"] }
        }
      }
    },

    "data_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "required": { "type": "boolean", "default": true },
          "log_sources": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["platform"],
              "additionalProperties": false,
              "properties": {
                "platform": { "type": "string" },
                "table": { "type": "string" },
                "log_source_type": { "type": "string" },
                "event_ids": { "type": "array", "items": { "type": "string" } },
                "required_fields": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },

    "enrichment_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "platform"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "enum": ["watchlist", "lookup", "reference_set", "threat_intel_feed", "saved_function"] },
          "platform": { "type": "string" },
          "required": { "type": "boolean" },
          "purpose": { "type": "string" }
        }
      }
    },

    "threat": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "identifier"],
        "additionalProperties": false,
        "properties": {
          "type": { "enum": ["actor", "campaign", "malware", "tool", "cve", "report"] },
          "identifier": { "type": "string" },
          "name": { "type": "string" },
          "relevance": { "enum": ["direct", "related"] },
          "source": { "type": "string" }
        }
      }
    },

    "implementations": {
      "type": "array",
      "items": { "$ref": "#/$defs/implementation" }
    },

    "sigma": {
      "type": "object",
      "required": ["present"],
      "additionalProperties": false,
      "properties": {
        "present": { "type": "boolean" },
        "authoritative": { "type": "boolean", "default": false },
        "file": { "type": "string" },
        "hash": { "type": "string" },
        "translation_coverage": { "enum": ["full", "partial", "documentation_only"] },
        "untranslatable": { "type": "array", "items": { "type": "string" } }
      }
    },

    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "partial", "passed", "failed", "stale"] },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_before_prod": { "type": "array", "items": { "$ref": "#/$defs/validationType" } },
            "revalidate_every_days": { "type": "integer", "minimum": 1 }
          }
        },
        "last_run": { "type": "string", "format": "date" },
        "last_result": { "enum": ["pass", "fail", "partial", "blocked", "not_applicable"] },
        "runs_index": { "type": "string" }
      }
    },

    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "given", "when", "then", "automation_status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "$ref": "#/$defs/validationType" },
          "description": { "type": "string" },
          "given": { "type": "string" },
          "when": { "type": "string" },
          "then": { "type": "string" },
          "data": { "type": "string" },
          "expected_match_count": { "type": "integer", "minimum": 0 },
          "expected_fields": { "type": "array", "items": { "type": "string" } },
          "negative": { "type": "boolean", "default": false },
          "automation_status": { "enum": ["manual", "semi_automated", "automated"] },
          "runner": { "enum": ["rsigma", "kql_unit", "atomic", "custom"] },
          "frequency": { "enum": ["on_change", "daily", "weekly", "monthly", "quarterly"] },
          "atomic_test_ref": { "type": "string" },
          "enabled": { "type": "boolean", "default": true }
        }
      }
    },

    "documentation": {
      "type": "object",
      "required": ["overview"],
      "additionalProperties": false,
      "properties": {
        "overview": { "type": "string" },
        "investigation": { "type": "string" },
        "false_positives": { "type": "string" },
        "response": { "type": "string" },
        "tuning": { "type": "string" },
        "changelog": { "type": "string" },
        "architecture": { "type": "string" },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "url"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string" },
              "url": { "type": "string", "format": "uri" },
              "accessed": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },

    "runbook": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "estimated_triage_minutes": { "type": "integer", "minimum": 1 },
        "soar_playbook_ref": { "type": ["string", "null"] },
        "escalation_criteria": { "type": "string" },
        "containment_actions": { "type": "array", "items": { "type": "string" } }
      }
    },

    "governance": {
      "type": "object",
      "required": ["owner"],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "type": "object",
          "required": ["team"],
          "additionalProperties": false,
          "properties": {
            "team": { "type": "string" },
            "contact": { "type": "string" }
          }
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "author": { "type": "string" },
            "maintainer": { "type": "string" },
            "approver": { "type": "string" },
            "stakeholders": { "type": "array", "items": { "type": "string" } }
          }
        },
        "review": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cadence_days": { "type": "integer", "minimum": 1 },
            "last_reviewed": { "type": "string", "format": "date" },
            "next_due": { "type": "string", "format": "date" }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "created": { "type": "string", "format": "date" },
            "promoted_to_prod": { "type": ["string", "null"], "format": "date" },
            "deprecated": { "type": ["string", "null"], "format": "date" },
            "retired": { "type": ["string", "null"], "format": "date" }
          }
        },
        "deprecation": {
          "type": "object",
          "required": ["reason"],
          "additionalProperties": false,
          "properties": {
            "reason": { "type": "string", "minLength": 10 },
            "replaced_by": { "type": ["string", "null"], "pattern": "^DET-\\d{4,}$" },
            "date": { "type": "string", "format": "date" }
          }
        },
        "compliance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "control"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string" },
              "control": { "type": "string" }
            }
          }
        }
      }
    },

    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": ["supersedes", "superseded_by", "duplicates", "complements", "depends_on", "variant_of", "broader_than", "narrower_than"]
          },
          "detection": { "type": ["string", "null"], "pattern": "^DET-\\d{4,}$" },
          "asset": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    },

    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "applies_to", "type", "justification", "risk_accepted", "active"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "applies_to": { "type": "string" },
          "type": { "enum": ["exclusion", "allowlist", "threshold_adjust", "suppression", "time_window"] },
          "finding": { "type": ["string", "null"] },
          "expression_file": { "type": "string" },
          "expression": { "type": "string" },
          "justification": { "type": "string", "minLength": 20 },
          "risk_accepted": { "type": "string", "minLength": 10 },
          "approved_by": { "type": "string" },
          "approved_at": { "type": "string", "format": "date" },
          "expires_at": { "type": ["string", "null"], "format": "date" },
          "scope": { "enum": ["global", "environment", "entity"] },
          "active": { "type": "boolean" }
        }
      }
    }
  },

  "$defs": {
    "severity": { "enum": ["info", "low", "medium", "high", "critical"] },

    "lifecycleStatus": {
      "enum": ["idea", "draft", "in_development", "in_review", "testing",
               "production_candidate", "active", "tuning", "degraded",
               "disabled", "deprecated", "retired"]
    },

    "validationType": {
      "enum": ["data_availability", "schema_validation", "syntax_validation",
               "logic_review", "unit_test", "regression_test",
               "historical_backtest", "noise_analysis", "tuning_validation",
               "performance_test", "atomic_test", "red_team", "purple_team",
               "deployment_validation", "production_validation"]
    },

    "implementation": {
      "type": "object",
      "required": ["id", "platform", "type", "status", "enabled", "logic", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^IMP-\\d{4,}-[A-Z0-9]+(-[A-Z0-9]+)*$" },
        "platform": { "type": "string" },
        "type": { "enum": ["generated", "generated_customized", "native"] },
        "status": { "enum": ["draft", "not_deployed", "active", "legacy", "deprecated", "disabled", "failed"] },
        "enabled": { "type": "boolean" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "inherits_from": { "type": ["string", "null"] },
        "logic": {
          "type": "object",
          "required": ["language", "file"],
          "additionalProperties": false,
          "properties": {
            "language": { "enum": ["kql", "aql", "sigma", "eql", "spl", "lucene", "yara", "suricata", "zeek", "fql"] },
            "file": { "type": "string" },
            "hash": { "type": "string" },
            "exclusions_file": { "type": "string" }
          }
        },
        "native_rule_id": { "type": ["string", "null"] },
        "native_rule_name": { "type": ["string", "null"] },
        "schedule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "frequency": { "type": "string" },
            "lookback": { "type": "string" },
            "cron": { "type": ["string", "null"] }
          }
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operator": { "enum": ["gt", "gte", "lt", "lte", "eq"] },
            "value": { "type": "number" },
            "group_by": { "type": "array", "items": { "type": "string" } }
          }
        },
        "suppression": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "duration": { "type": "string" }
          }
        },
        "entity_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity", "identifier", "column"],
            "additionalProperties": false,
            "properties": {
              "entity": { "type": "string" },
              "identifier": { "type": "string" },
              "column": { "type": "string" }
            }
          }
        },
        "custom_details": { "type": "object", "additionalProperties": { "type": "string" } },
        "alert_grouping": { "type": "object" },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "sigma_backed": { "type": "boolean" },
        "sigma_hash": { "type": ["string", "null"] },
        "generated_at": { "type": ["string", "null"], "format": "date-time" },
        "customized": { "type": "boolean" },
        "notes": { "type": "string" },
        "deprecation_notes": { "type": "string" }
      },

      "allOf": [
        {
          "if": { "properties": { "type": { "const": "generated" } }, "required": ["type"] },
          "then": {
            "properties": {
              "sigma_backed": { "const": true },
              "customized": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "native" } }, "required": ["type"] },
          "then": { "properties": { "sigma_backed": { "const": false } } }
        }
      ]
    }
  },

  "allOf": [
    {
      "comment": "R-04 / R-03: an active detection requires an owner and implementations",
      "if": {
        "properties": { "status": { "enum": ["active", "tuning", "degraded", "production_candidate"] } },
        "required": ["status"]
      },
      "then": { "required": ["implementations", "governance", "mitre", "data_sources"] }
    },
    {
      "comment": "A deprecated detection must declare the reason",
      "if": { "properties": { "status": { "const": "deprecated" } }, "required": ["status"] },
      "then": {
        "properties": {
          "governance": { "required": ["deprecation"] }
        }
      }
    }
  ]
}
